<?xml version="1.0" encoding="utf-8"?>
<!-- La sesión de WhatsApp y los datos del bot nunca salen del teléfono: ni copias en la nube ni transferencia a otro equipo. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
